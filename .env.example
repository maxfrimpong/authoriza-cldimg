# SendREQ — client build configuration
# Copy to .env.local and fill in. Only VITE_* vars are exposed to the browser.
# The anon key is public by design (it is safe to ship) but is kept out of
# source so it can be rotated and so builds fail loudly when misconfigured.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public URL used for the "Open SendREQ" buttons in emails. Optional; defaults
# to the running origin. Set it to your deployed URL so links work in email.
VITE_APP_URL=https://sendreq.yourdomain/#/

# ---------------------------------------------------------------------------
# Server-side only — these are NOT build vars. Set them as Supabase Function
# secrets, never in this client env:
#   supabase secrets set RESEND_API_KEY=re_xxxxx
#   supabase secrets set RESEND_FROM="SendREQ <notifications@yourdomain>"
#   supabase secrets set GEMINI_API_KEY=xxxx
# ---------------------------------------------------------------------------
